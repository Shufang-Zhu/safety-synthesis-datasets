		in_0;
		in_1;
		in_2;
		in_3;
		in_4;
		in_5;
	}
	OUTPUTS {
		out_0;
		out_1;
		out_2;
		out_3;
		out_4;
		out_5;
	}
	GUARANTEE {
		 G (((((((!in_0 || out_1) && (!out_1 || in_0)) && ((!in_1 || out_2) && (!out_2 || in_1))) && ((!in_2 || out_3) && (!out_3 || in_2))) && ((!in_3 || out_4) && (!out_4 || in_3))) && ((!in_4 || out_5) && (!out_5 || in_4))) && ((!in_5 || out_0) && (!out_0 || in_5)))

	}
}