INFO {
TITLE :          "n-ary mux"
DESCRIPTION :    "selects the output out of a set of inputs according to a given
 binary encoded input"
SEMANTICS :      Mealy
TARGET :         Mealy

}
MAIN {
	INPUTS {
		in_0;
		in_1;
		in_2;
		in_3;
		select_0;
		select_1;
	}
	OUTPUTS {
		out;
	}
	GUARANTEE {
		 G (((((((in_3 || in_2) || in_1) || in_0) || ((!out || in_0) && (!in_0 || out))) && ((((in_3 || in_2) || in_1) || !in_0) || ((!out || in_1) && (!in_1 || out)))) && ((((in_3 || in_2) || !in_1) || in_0) || ((!out || in_2) && (!in_2 || out)))) && ((((in_3 || in_2) || !in_1) || !in_0) || ((!out || in_3) && (!in_3 || out))))

	}
}